    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;109;-1056,160;Inherit;False;_UdonSpecularLightDir;0;32;2;False;False;0;1;True;Object;-1;4;0;INT;0;False;2;INT;0;False;1;INT;0;False;3;INT;0;False;1;FLOAT4;0\nNode;AmplifyShaderEditor.GlobalArrayNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;102;-1056,-176;Inherit;False;_UdonSpecularLightCol;0;32;2;False;False;0;1;True;Object;-1;4;0;INT;0;False;2;INT;0;False;1;INT;0;False;3;INT;0;False;1;FLOAT4;0\nNode;AmplifyShaderEditor.GlobalArrayNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;103;-1056,-288;Inherit;False;_UdonSpecularLightPos;0;32;2;False;False;0;1;True;Object;-1;4;0;INT;0;False;2;INT;0;False;1;INT;0;False;3;INT;0;False;1;FLOAT4;0\nNode;AmplifyShaderEditor.GlobalArrayNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;105;-1088,-64;Inherit;False;_UdonSpecularLightRight;0;32;2;False;False;0;1;True;Object;-1;4;0;INT;0;False;2;INT;0;False;1;INT;0;False;3;INT;0;False;1;FLOAT4;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;110;-608,-176;Inherit;False;Metallic;1;2;False;1;0;FLOAT;0;False;1;FLOAT;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;111;-608,-336;Inherit;False;Albedo;3;0;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.RangedFloatNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;101;-1088,-384;Inherit;False;Global;_UdonSpecularLightCount;_UdonSpecularLightCount;44;0;Create;True;0;0;0;True;0;False;0;11;0;0;0;1;FLOAT;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;98;-640,224;Inherit;False;World
    Normal;3;7;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;106;-640,304;Inherit;False;View
    Direction;3;8;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;107;-640,144;Inherit;False;World
    Position;3;6;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;108;-608,64;Inherit;False;Fresnel;3;5;False;1;0;FLOAT3;1,1,1;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;100;-608,-256;Inherit;False;Lightmap;3;1;False;1;0;FLOAT3;1,1,1;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;112;-608,-16;Inherit;False;IOR;1;4;False;1;0;FLOAT;1.5;False;1;FLOAT;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;99;-640,-96;Inherit;False;Smoothness;1;3;False;1;0;FLOAT;0;False;1;FLOAT;0\nNode;AmplifyShaderEditor.CustomExpressionNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;97;-320,-128;Inherit;False;//
    --- CONFIGURATION ---$float LumaStart = 0.05@$float LumaEnd = 1.0@$float RadiusFadeStart
    = 7.0@$float specBoost = 2.0@$$#if defined(SHADER_API_MOBILE)$    #define MAX_RADIUS
    10.0$#else$    #define MAX_RADIUS 20.0$#endif$$// --- INITIALISATION ---$float3
    N = normalize(WorldNormal)@$float3 vDir = normalize(ViewDir)@$$// Calcul de F0
    (R\xE9flectance de base)$float3 f0_dielectric = float3(0.04, 0.04, 0.04)@$float3
    F0 = lerp(f0_dielectric, AlbedoColor.rgb, Metallic)@$$// Masques de distance
    et de Lightmap$float luma = dot(LightmapColor, float3(0.22, 0.70, 0.08))@$float
    lmMask = saturate((luma - LumaStart) / max(LumaEnd - LumaStart, 0.0001))@$float
    playerDist = distance(_WorldSpaceCameraPos, WorldPos)@$float fadeT = saturate((playerDist
    - RadiusFadeStart) / max(MAX_RADIUS - RadiusFadeStart, 0.0001))@$float radiusFade
    = 1.0 - (fadeT * fadeT * (3.0 - 2.0 * fadeT))@$$// Sortie pr\xE9coce$if (lmMask
    < 0.001 || Smoothness < 0.01 || _UdonSpecularLightCount == 0 || radiusFade <
    0.001) return 0@$$// --- MATHS BLINN-PHONG ---$// On transforme le Smoothness
    en exposant (Shininess)$// On utilise une plage large pour un contr\xF4le fin
    (jusqu'\xE0 2048)$float shininess = exp2(10.0 * Smoothness + 1.0)@ $$// FACTEUR
    DE NORMALISATION : C'est ici que la magie op\xE8re.$// Cette formule assure que
    plus 'shininess' est petit (plus c'est rugueux), $// plus l'intensit\xE9 globale
    baisse.$float normalization = (shininess + 8.0) / (8.0 * 3.14159)@$$float3 R
    = reflect(-vDir, N)@$float3 specAccum = 0.0@$$// --- BOUCLE DE LUMI\xC8RES ---$for
    (int i = 0@ i < (int)_UdonSpecularLightCount@ i++) {$    float4 posRange = _UdonSpecularLightPos[i]@$   
    float3 L_center = posRange.xyz - WorldPos@$    float distSqCenter = dot(L_center,
    L_center)@$    float rangeSq = posRange.w * posRange.w@$$    if (distSqCenter
    > rangeSq) continue@$$    float4 dirAngle = _UdonSpecularLightDir[i]@$    float3
    L_center_norm = L_center * rsqrt(distSqCenter + 0.00001)@$    float spotMask
    = saturate((dot(-L_center_norm, dirAngle.xyz) - dirAngle.w) / max(0.01, 1.0 -
    dirAngle.w))@$$    if (spotMask <= 0.0) continue@$$    // Calcul de l'intersection
    pour Area Lights$    float denom = dot(dirAngle.xyz, R)@$    // On s\xE9curise
    le d\xE9nominateur pour \xE9viter les divisions par z\xE9ro$    float tPlane
    = (dirAngle.w < -0.9) ? dot(L_center, R) : (dot(L_center, dirAngle.xyz) / (abs(denom)
    < 0.001 ? 0.001 : denom))@$    $    float3 intersection = R * max(0.0, tPlane)@$   
    float3 localP = (WorldPos + intersection) - posRange.xyz@$$    float2 halfSize
    = float2(_UdonSpecularLightRight[i].w, _UdonSpecularLightUp[i].w)@$    float2
    clampedPos = clamp(float2(dot(localP, _UdonSpecularLightRight[i].xyz), dot(localP,
    _UdonSpecularLightUp[i].xyz)), -halfSize, halfSize)@$    float3 closestPoint
    = posRange.xyz + _UdonSpecularLightRight[i].xyz * clampedPos.x + _UdonSpecularLightUp[i].xyz
    * clampedPos.y@$$    float3 diff = closestPoint - WorldPos@$    float distSq
    = dot(diff, diff)@$    float3 lDir = normalize(diff)@$    float3 H = normalize(lDir
    + vDir)@$$    // Calculs de base$    float nDotL = saturate(dot(N, lDir))@$   
    float nDotH = saturate(dot(N, H))@$    float hDotV = saturate(dot(H, vDir))@$$   
    // Terme Sp\xE9culaire Blinn-Phong Normalis\xE9$    // nDotH^shininess * normalization$   
    float spec = pow(nDotH, shininess) * normalization@$$    // Fresnel (Schlick)
    : Pour que les bords brillent plus que le centre$    float3 fresnel = F0 + (1.0
    - F0) * pow(1.0 - hDotV, 5.0)@$$    // Att\xE9nuation de la lumi\xE8re$    float
    falloff = saturate(1.0 - distSqCenter/rangeSq)@$    falloff = (falloff * falloff)
    / (distSq + 1.0)@$$    // Accumulation finale pour cette lumi\xE8re$    specAccum
    += _UdonSpecularLightCol[i].rgb * (spec * fresnel * nDotL * _UdonSpecularLightCol[i].w
    * falloff * spotMask)@$}$$return specAccum * specBoost * radiusFade * lmMask@;3;Create;9;True;AlbedoColor;FLOAT3;0,0,0;In;;Inherit;False;True;LightmapColor;FLOAT3;0,0,0;In;;Inherit;False;True;Metallic;FLOAT;0;In;;Inherit;False;True;Smoothness;FLOAT;0;In;;Inherit;False;True;IOR;FLOAT;0;In;;Inherit;False;True;Fresnel;FLOAT3;0,0,0;In;;Inherit;False;True;WorldPos;FLOAT3;0,0,0;In;;Inherit;False;True;WorldNormal;FLOAT3;0,0,0;In;;Inherit;False;True;ViewDir;FLOAT3;0,0,0;In;;Inherit;False;Specular;False;False;0;3bfd1f09d3da9a141a32ad22cecc5505;False;9;0;FLOAT3;0,0,0;False;1;FLOAT3;0,0,0;False;2;FLOAT;0;False;3;FLOAT;0;False;4;FLOAT;0;False;5;FLOAT3;0,0,0;False;6;FLOAT3;0,0,0;False;7;FLOAT3;0,0,0;False;8;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionOutput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;0;0,-128;Inherit;False;True;-1;Speculars;0;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nWireConnection;97;0;111;0\nWireConnection;97;1;100;0\nWireConnection;97;2;110;0\nWireConnection;97;3;99;0\nWireConnection;97;4;112;0\nWireConnection;97;5;108;0\nWireConnection;97;6;107;0\nWireConnection;97;7;98;0\nWireConnection;97;8;106;0\nWireConnection;0;0;97;0\nASEEND*/\n//CHKSM=C026B872D9E0F82F8A9F7339703FDEA7A84D6E0C"

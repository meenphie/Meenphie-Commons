    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;99;-640,-96;Inherit;False;Smoothness;1;3;False;1;0;FLOAT;0;False;1;FLOAT;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;106;-640,224;Inherit;False;View
    Direction;3;7;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.CustomExpressionNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;97;-320,-128;Inherit;False;//
    --- CONFIGURATION ---$static const float lumaStart            = 0.05@$static
    const float lumaEnd              = 1.0@$static const float specBoost           
    = 0.1@ $static const int   roughnessAttenuation = 3@$static const float metallicInfluence   
    = 0.75@ $$#if defined(SHADER_API_MOBILE)$static const float MAX_DIST = 8.0@$#else$static
    const float MAX_DIST = 16.0@$#endif$$static const float fadeStart = 0.0@$static
    const float fadeEnd   = MAX_DIST@$$// --- INITIALISATION ---$float3 N    = normalize(WorldNormal)@$float3
    vDir = normalize(ViewDir)@$float3 R    = reflect(-vDir, N)@$$// --- ALBEDO &
    FRESNEL ---$float3 F0 = lerp(0.04, Color.rgb, Metallic)@$$// --- MASQUES LIGHTMAP
    ---$float luma   = dot(LightmapColor, float3(0.2126, 0.7152, 0.0722))@$float
    lmMask = saturate((luma - lumaStart) / max(lumaEnd - lumaStart, 1e-4))@$$if (lmMask
    * Smoothness < 0.0001 || _UdonSpecularLightCount < 0.5) return 0.0@$$// --- MATHS
    GLOBALES ---$float roughness = 1.0 - Smoothness@$float alpha     = roughness
    * roughness@$float alpha2    = max(alpha * alpha, 0.0001)@$$// --- ENERGY FACTOR
    & UNIFIED BOOST ---$// On calcule l'influence r\xE9elle du m\xE9tal bas\xE9e
    sur la nouvelle variable de contr\xF4le$float metalFactor = Metallic * metallicInfluence@$$//
    1. Att\xE9nuation$float r_inv = Smoothness@ $float attenuation = r_inv@$[unroll(8)]$for
    (int e = 1@ e < roughnessAttenuation@ e++) {$    attenuation *= r_inv@$}$float
    energyFactor = lerp(attenuation, 1.0, metalFactor)@$$// 2. SpecBoost unifi\xE9$float
    finalSpecBoost = lerp(specBoost, 1.0, metalFactor)@$$float  nDotV     = max(dot(N,
    vDir), 1e-4)@$float3 specAccum = 0@$$int loopCount = (int)_UdonSpecularLightCount@$$for
    (int i = 0@ i < loopCount@ i++) {$    float4 posRange = _UdonSpecularLightPos[i]@$$   
    // 1. Distance Fading$    float distToPlayer = distance(_WorldSpaceCameraPos,
    posRange.xyz)@$    float distanceFade = 1.0 - saturate((distToPlayer - fadeStart)
    / (fadeEnd - fadeStart))@$    distanceFade       = distanceFade * distanceFade
    * (3.0 - 2.0 * distanceFade)@$    if (distanceFade <= 0.0) continue@$$    float3
    L_vector = posRange.xyz - WorldPos@$    float  distSq   = dot(L_vector, L_vector)@$   
    float4 dirAngle = _UdonSpecularLightDir[i]@$    float3 L_norm   = L_vector *
    rsqrt(max(distSq, 1e-6))@$$    // 2. Spot Mask$    float spotMask = saturate((dot(-L_norm,
    dirAngle.xyz) - dirAngle.w) / max(0.01, 1.0 - dirAngle.w))@$    if (spotMask
    <= 0.0) continue@$$    float3 diff     = 0@$    float  rectMask = 1.0@$    float2
    halfSize = float2(_UdonSpecularLightRight[i].w, _UdonSpecularLightUp[i].w)@$$   
    [branch]$    if (dirAngle.w < -0.9) {$        diff = L_vector@$    }$    else
    {$        // 3. Most Representative Point$        float denom  = dot(dirAngle.xyz,
    R)@$        float tPlane = dot(L_vector, dirAngle.xyz) / (abs(denom) < 1e-4 ?
    1e-4 : denom)@$        if (tPlane <= 0.0) continue@$$        float3 pReflection
    = WorldPos + R * tPlane@$        float3 lp          = pReflection - posRange.xyz@$       
    float2 localP      = float2(dot(lp, _UdonSpecularLightRight[i].xyz),$           
    dot(lp, _UdonSpecularLightUp[i].xyz))@$        float2 clampedPos  = clamp(localP,
    -halfSize, halfSize)@$        diff = posRange.xyz$        + _UdonSpecularLightRight[i].xyz
    * clampedPos.x$        + _UdonSpecularLightUp[i].xyz    * clampedPos.y$       
    - WorldPos@$$        // 4. Rectangle Mask$        float  softness   = max(0.1,
    roughness * 2.0)@$        float2 distToEdge = abs(localP) - halfSize@$       
    rectMask = smoothstep(softness, 0.0, length(max(distToEdge, 0.0)))@$    }$$   
    if (rectMask <= 0.0) continue@$$    float  dSqDiff = dot(diff, diff)@$    float3
    lDir    = diff * rsqrt(max(dSqDiff, 1e-6))@$    float3 H       = normalize(lDir
    + vDir)@$$    float nDotH = saturate(dot(N, H))@$    float nDotL = saturate(dot(N,
    lDir))@$    float hDotV = saturate(dot(H, vDir))@$$    // 5. Fresnel Schlick$   
    float3 fresnel = F0 + (1.0 - F0) * pow(1.0 - hDotV, 5.0)@$$    // 6. NDF GGX$   
    float d_denom = nDotH * nDotH * (alpha2 - 1.0) + 1.0@$    float D       = alpha2
    / (3.14159265 * d_denom * d_denom + 1e-7)@$$    // 7. Visibilit\xE9 Smith$   
    float k  = alpha * 0.5@$    float Gv = nDotV / (nDotV * (1.0 - k) + k)@$    float
    Gl = nDotL / (nDotL * (1.0 - k) + k)@$    float G  = Gv * Gl@$$    // 8. BRDF
    Sp\xE9culaire$    float3 spec = (D * fresnel * G) / max(4.0 * nDotV * nDotL,
    0.01)@$$    // 9. Accumulation$    float3 result = _UdonSpecularLightCol[i].rgb$   
    * _UdonSpecularLightCol[i].w$    * spec$    * nDotL$    * spotMask$    * distanceFade$   
    * rectMask$    * finalSpecBoost$    * energyFactor@$$    specAccum += max(0.0,
    result)@$}$$return specAccum * lmMask@;3;Create;8;True;Color;FLOAT3;0,0,0;In;;Inherit;False;True;LightmapColor;FLOAT3;0,0,0;In;;Inherit;False;True;Metallic;FLOAT;0;In;;Inherit;False;True;Smoothness;FLOAT;0;In;;Inherit;False;True;IOR;FLOAT;0;In;;Inherit;False;True;WorldPos;FLOAT3;0,0,0;In;;Inherit;False;True;WorldNormal;FLOAT3;0,0,0;In;;Inherit;False;True;ViewDir;FLOAT3;0,0,0;In;;Inherit;False;Direct
    Specular;False;False;0;;False;8;0;FLOAT3;0,0,0;False;1;FLOAT3;0,0,0;False;2;FLOAT;0;False;3;FLOAT;0;False;4;FLOAT;0;False;5;FLOAT3;0,0,0;False;6;FLOAT3;0,0,0;False;7;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionOutput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;0;0,-128;Inherit;False;True;-1;Speculars;0;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nWireConnection;97;0;111;0\nWireConnection;97;1;100;0\nWireConnection;97;2;110;0\nWireConnection;97;3;99;0\nWireConnection;97;4;112;0\nWireConnection;97;5;107;0\nWireConnection;97;6;98;0\nWireConnection;97;7;106;0\nWireConnection;0;0;97;0\nASEEND*/\n//CHKSM=E3D6F9448FE6591FCBF8281D4215A0A4AC0FA153"

    Direction;3;2;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;9;-112,336;Inherit;False;Smoothness;1;4;False;1;0;FLOAT;0;False;1;FLOAT;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;14;-112,96;Inherit;False;World
    Normal;3;1;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.CustomExpressionNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;1;208,128;Inherit;False;//
    --- 1. SETUP DES VECTEURS ---$float3 N = normalize(WorldNormal)@$float3 V = normalize(ViewDir)@$float3
    R = reflect(-V, N)@$$// --- 2. BOX PROJECTION ---$float3 ray = R@$if (unity_SpecCube0_ProbePosition.w
    > 0.0)${$    float3 factors = ((ray > 0.0 ? unity_SpecCube0_BoxMax.xyz : unity_SpecCube0_BoxMin.xyz)
    - WorldPos) / ray@$    float scalar = min(min(factors.x, factors.y), factors.z)@$   
    ray = ray * scalar + (WorldPos - unity_SpecCube0_ProbePosition.xyz)@$}$$// ---
    3. SAMPLING ---$// CORRECTED: Smoothness 1.0 -> Mip 0 | Smoothness 0.0 -> Mip
    7$float mipLevel = (1.0 - Smoothness) * 7.0@$$float4 envSample = UNITY_SAMPLE_TEXCUBE_LOD(unity_SpecCube0,
    ray, mipLevel)@$float3 indirectSpec = DecodeHDR(envSample, unity_SpecCube0_HDR)@$$return
    indirectSpec * Fresnel@;3;Create;5;True;WorldPos;FLOAT3;0,0,0;In;;Inherit;False;True;WorldNormal;FLOAT3;0,0,0;In;;Inherit;False;True;ViewDir;FLOAT3;0,0,0;In;;Inherit;False;True;Fresnel;FLOAT3;0,0,0;In;;Inherit;False;True;Smoothness;FLOAT;0;In;;Inherit;False;Indirect
    Specular With Box Projection;True;False;0;;False;5;0;FLOAT3;0,0,0;False;1;FLOAT3;0,0,0;False;2;FLOAT3;0,0,0;False;3;FLOAT3;0,0,0;False;4;FLOAT;0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,

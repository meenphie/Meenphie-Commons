  m_Script: {fileID: 11500000, guid: 78b2425a2284af743826c689403a4924, type: 3}
  m_Name: Indirect Geometric Specular
  m_EditorClassIdentifier: 
  m_functionInfo: "// Made with Amplify Shader Editor v1.9.9.7\n// Available at the
    Unity Asset Store - http://u3d.as/y3X \n/*ASEBEGIN\nVersion=19907\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;13;-176,528;Inherit;False;View
    Direction;3;7;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;14;-176,448;Inherit;False;World
    Normal;3;6;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;15;-176,368;Inherit;False;World
    Position;3;5;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;9;-176,128;Inherit;False;Smoothness;1;2;False;1;0;FLOAT;0;False;1;FLOAT;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;10;-144,-32;Inherit;False;Color;3;0;False;1;0;FLOAT3;1,1,1;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;19;-144,48;Inherit;False;Metallic;1;1;False;1;0;FLOAT;0;False;1;FLOAT;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;16;-144,288;Inherit;False;Fresnel;3;4;False;1;0;FLOAT3;1,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionInput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;17;-144,208;Inherit;False;IOR;1;3;False;1;0;FLOAT;1.5;False;1;FLOAT;0\nNode;AmplifyShaderEditor.CustomExpressionNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;1;128,128;Inherit;False;//
    --- 1. VECTEURS & NORMALES ---$// On s'assure que N inclut bien la Normal Map
    (doit \xEAtre fait avant d'entrer ici)$float3 N = normalize(WorldNormal)@ $float3
    V = normalize(ViewDir)@$float3 R = reflect(-V, N)@$float nDotV = saturate(dot(N,
    V))@$$// --- 2. R\xC9FLEXION (Rayon) ---$float3 ray = R@$$// Correction VRChat
    : On ne fait la Box Projection que si on est sur un objet statique.$// Si c'est
    pour un avatar, il vaut mieux commenter cette section \"if\".$if (unity_SpecCube0_ProbePosition.w
    > 0.0) {$    float3 factors = ((ray > 0.0 ? unity_SpecCube0_BoxMax.xyz : unity_SpecCube0_BoxMin.xyz)
    - WorldPos) / ray@$    float scalar = min(min(factors.x, factors.y), factors.z)@$   
    // On ajoute un petit \"bias\" pour \xE9viter que la box ne plaque la normale
    \xE0 plat$    ray = ray * scalar + (WorldPos - unity_SpecCube0_ProbePosition.xyz)@$}$$//
    --- 3. PBR F0 & FRESNEL (Smoothness-aware) ---$// Calcul de l'indice de r\xE9fraction
    (IOR) vers F0$float f0_ior = pow((IOR - 1.0) / (IOR + 1.0), 2.0)@$float3 F_base
    = lerp(float3(f0_ior, f0_ior, f0_ior), Color, Metallic)@$$// Fresnel de Schlick
    modifi\xE9 : on utilise le Smoothness pour \xE9viter le \"glow\" excessif sur
    les bords$float3 fresnelFactor = F_base + (max(float3(Smoothness, Smoothness,
    Smoothness), F_base) - F_base) * pow(1.0 - nDotV, 5.0)@$$// --- 4. SAMPLING ---$//
    On utilise une courbe plus douce pour les Mips afin de ne pas perdre le relief
    trop vite$float mipLevel = pow(1.0 - Smoothness, 1.5) * 7.0@ $float4 sampleCube
    = UNITY_SAMPLE_TEXCUBE_LOD(unity_SpecCube0, ray, mipLevel)@$float3 indirectSpec
    = DecodeHDR(sampleCube, unity_SpecCube0_HDR)@$$return indirectSpec * fresnelFactor@;3;Create;8;True;Color;FLOAT;0;In;;Inherit;False;True;Metallic;FLOAT;0;In;;Inherit;False;True;Smoothness;FLOAT;0;In;;Inherit;False;True;IOR;FLOAT;0;In;;Inherit;False;True;Fresnel;FLOAT3;0,0,0;In;;Inherit;False;True;WorldPos;FLOAT3;0,0,0;In;;Inherit;False;True;WorldNormal;FLOAT3;0,0,0;In;;Inherit;False;True;ViewDir;FLOAT3;0,0,0;In;;Inherit;False;Indirect
    Specular With Box Projection;True;False;0;;False;8;0;FLOAT;0;False;1;FLOAT;0;False;2;FLOAT;0;False;3;FLOAT;0;False;4;FLOAT3;0,0,0;False;5;FLOAT3;0,0,0;False;6;FLOAT3;0,0,0;False;7;FLOAT3;0,0,0;False;1;FLOAT3;0\nNode;AmplifyShaderEditor.FunctionOutput,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;0;512,128;Inherit;False;True;-1;Reflections;0;False;1;0;FLOAT3;0,0,0;False;1;FLOAT3;0\nWireConnection;1;0;10;0\nWireConnection;1;1;19;0\nWireConnection;1;2;9;0\nWireConnection;1;3;17;0\nWireConnection;1;4;16;0\nWireConnection;1;5;15;0\nWireConnection;1;6;14;0\nWireConnection;1;7;13;0\nWireConnection;0;0;1;0\nASEEND*/\n//CHKSM=CFB521B6E7D39D6A581CA4DEE855BA7F9A298D2E"
